const db = mysql.createConnection({
  host:     process.env.DB_HOST     || "localhost",
  user:     process.env.DB_USER     || "root",
  password: process.env.DB_PASSWORD || "1234",
  database: process.env.DB_NAME     || "padaria_db",
  port:     process.env.DB_PORT     ? parseInt(process.env.DB_PORT) : 3306,
  ssl:      process.env.DB_SSL === "true" ? { rejectUnauthorized: false } : undefined,
});

// CRIAÇÃO AUTOMÁTICA DAS TABELAS (PLANO DE EMERGÊNCIA PARA A APRESENTAÇÃO)
db.connect((err) => {
  if (err) {
    console.error("Erro fatal ao conectar ao banco no Railway:", err);
    return;
  }
  console.log("Conectado ao MariaDB/MySQL com sucesso!");

  // Lista de queries organizadas na ordem correta para não dar erro de chave estrangeira
  const queries = [
    // 1. Tabela Funcionarios
    `CREATE TABLE IF NOT EXISTS funcionarios (
      id int(11) NOT NULL AUTO_INCREMENT,
      nome varchar(255) NOT NULL,
      email varchar(255) NOT NULL,
      telefone varchar(20) DEFAULT NULL,
      cpf varchar(14) DEFAULT NULL,
      rg varchar(20) DEFAULT NULL,
      numero_funcionario varchar(50) DEFAULT NULL,
      cargo varchar(100) DEFAULT NULL,
      senha varchar(255) NOT NULL,
      data_cadastro timestamp NULL DEFAULT current_timestamp(),
      PRIMARY KEY (id),
      UNIQUE KEY email (email)
    ) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;`,

    // 2. Tabela Produtos
    `CREATE TABLE IF NOT EXISTS produtos (
      id int(11) NOT NULL AUTO_INCREMENT,
      nome varchar(255) NOT NULL,
      categoria enum('doces','salgados','diet') NOT NULL,
      preco_venda decimal(10,2) NOT NULL,
      preco_custo decimal(10,2) DEFAULT 0.00,
      estoque int(11) DEFAULT 0,
      codigo_produto varchar(50) DEFAULT NULL,
      descricao varchar(255) NOT NULL DEFAULT '',
      ativo tinyint(1) NOT NULL DEFAULT 1,
      data_cadastro timestamp NULL DEFAULT current_timestamp(),
      PRIMARY KEY (id)
    ) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;`,

    // 3. Tabela Vendas
    `CREATE TABLE IF NOT EXISTS vendas (
      id int(11) NOT NULL AUTO_INCREMENT,
      data_venda datetime NOT NULL,
      total decimal(10,2) NOT NULL,
      forma_pagamento varchar(50) NOT NULL,
      PRIMARY KEY (id)
    ) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;`,

    // 4. Tabela Itens_Venda (Depende de vendas e produtos)
    `CREATE TABLE IF NOT EXISTS itens_venda (
      id int(11) NOT NULL AUTO_INCREMENT,
      venda_id int(11) NOT NULL,
      produto_id int(11) NOT NULL,
      quantidade int(11) NOT NULL,
      valor_unitario decimal(10,2) NOT NULL,
      subtotal decimal(10,2) NOT NULL,
      PRIMARY KEY (id),
      KEY venda_id (venda_id),
      KEY produto_id (produto_id),
      CONSTRAINT fk_itens_venda_vendas FOREIGN KEY (venda_id) REFERENCES vendas (id) ON DELETE CASCADE,
      CONSTRAINT fk_itens_venda_produtos FOREIGN KEY (produto_id) REFERENCES produtos (id)
    ) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;`
  ];

  // Executa uma query de cada vez de forma síncrona/sequencial simples
  let executadas = 0;
  queries.forEach((query, index) => {
    db.query(query, (queryErr) => {
      if (queryErr) {
        console.error(`Erro ao criar tabela na posição ${index}:`, queryErr.message);
      } else {
        executadas++;
        if (executadas === queries.length) {
          console.log("🚀 SUCESSO: Todas as tabelas do projeto Padaria estão prontas e estruturadas na nuvem!");
        }
      }
    });
  });
});
